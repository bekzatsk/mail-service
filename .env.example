DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mail_service
DB_USER=root
DB_PASS=


# Master API key for admin operations (create organizations, register clients)
# Generate with: ruby -e "require 'securerandom'; puts SecureRandom.hex(32)"
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here
MASTER_API_KEY=

# Public origin of this service, used to build the Telegram webhook URL.
# Must be https and reachable from Telegram. Without it, registering a webhook
# falls back to whatever the request claims, which is a guess behind a proxy.
PUBLIC_BASE_URL=https://email.innlab.kz

# Telegram gateway (bot tokens are stored per client in DB, not here)
# TELEGRAM_ENABLED=false disables the polling supervisor entirely. Webhook bots
# keep working without it — they need no threads.
TELEGRAM_ENABLED=true
TELEGRAM_POLL_TIMEOUT_SECONDS=30
TELEGRAM_HANDLER_TIMEOUT_SECONDS=10
TELEGRAM_UNKNOWN_COMMAND_REPLY=false
TELEGRAM_HTTP_USER_AGENT=mail-service/telegram-gateway

# POST /send attachments (defaults shown). Keep a reverse proxy's body limit
# (nginx client_max_body_size) at or above MAIL_MAX_REQUEST_BYTES.
# MAIL_ATTACHMENTS_MAX_COUNT=5
# MAIL_ATTACHMENT_MAX_BYTES=10485760
# MAIL_ATTACHMENTS_MAX_TOTAL_BYTES=20971520
# MAIL_ATTACHMENT_ALLOWED_TYPES=application/pdf
# MAIL_MAX_REQUEST_BYTES=29010604
# Idempotency-Key retention, and SMTP timeouts for /send
# MAIL_IDEMPOTENCY_TTL_HOURS=24
# MAIL_SMTP_OPEN_TIMEOUT_SECONDS=10
# MAIL_SMTP_READ_TIMEOUT_SECONDS=60

# Largest request body any endpoint other than /send accepts (default 1 MiB).
# MAX_REQUEST_BYTES=1048576
